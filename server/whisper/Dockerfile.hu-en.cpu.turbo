FROM docker.io/library/python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip3 install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cpu
RUN pip3 install --no-cache-dir \
        "faster-whisper>=1.0.3" \
        "transformers>=4.40.0" \
        fastapi uvicorn pydantic python-multipart

ENV CT2_FORCE_CPU_ISA=AVX512

COPY whisper_server.py .
EXPOSE 13000
# Hungarian speech → English text.
# Maxdorger29 LoRA outputs English regardless of task param — use it as
# a HU→EN translation ASR so the LLM can reason in English and just
# reply in Hungarian via the system prompt.
CMD ["python3", "whisper_server.py", \
     "--model", "Maxdorger29/whisper-large-v3-turbo-hungarian-lora", \
     "--device", "cpu", \
     "--compute-type", "int8", \
     "--feature-size", "128", \
     "--port", "13000"]
