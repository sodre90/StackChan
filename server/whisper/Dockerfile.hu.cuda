FROM docker.io/nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip3 install --no-cache-dir \
        "torch[cpu]" \
        "faster-whisper>=1.0.3" \
        "ctranslate2>=4.5.0" \
        "transformers>=4.40.0" \
        fastapi uvicorn pydantic python-multipart

COPY whisper_server.py .
EXPOSE 13000
# Hungarian-tuned Whisper (sarpba/whisper-base-hungarian_v1), CUDA-accelerated
# on NVIDIA GPUs (RTX 5070 Ti, etc.). Pre-quantized CTranslate2 in
# quants/int8_bfloat16 subfolder. int8_float16 is the sweet spot for
# RTX 40/50 series — fast and accurate.
CMD ["python3", "whisper_server.py", \
     "--model", "sarpba/whisper-base-hungarian_v1", \
     "--model-subfolder", "quants/int8_bfloat16", \
     "--device", "cuda", \
     "--compute-type", "int8_float16", \
     "--port", "13000"]
